{
  "name": "guessle",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "link-preview": "node scripts/render-link-preview.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:single": "playwright test --max-failures=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "vitest run && playwright test",
    "firebase:emulators": "pnpm --config.engine-strict=false --dir functions build && firebase emulators:start --project demo-number-guessing",
    "firebase:emulators:exec": "pnpm --config.engine-strict=false --dir functions build && firebase emulators:exec --project demo-number-guessing --only auth,firestore,functions",
    "firebase:firestore:exec": "firebase emulators:exec --project demo-number-guessing --only firestore",
    "test:functions": "pnpm --config.engine-strict=false --dir functions test",
    "test:firebase": "pnpm firebase:emulators:exec \"pnpm --config.engine-strict=false --dir functions test:emulator && pnpm vitest run --config vitest.firebase.config.ts\"",
    "test:e2e:online": "pnpm firebase:emulators:exec \"pnpm exec playwright test e2e/online-multiplayer.spec.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "firebase-tools": "^15.24.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  }
}
